#export {insertion_sort}
func insertion_sort() {
    let key : float = 1.0
    let j: int
    let temp: int
    for (let i: int = 1, i < n, set i += 1) {

        set key = a[i]
        set j = i - 1
        
        asLongAs ( j >= 0 and a[j] > key ) {
            set temp = j + 1
            set a[temp] = a[j]
            set j = j - 1

        }

        set j = j + 1
        set a[j] = key

    }
}