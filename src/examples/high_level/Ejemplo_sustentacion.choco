let n : int = 5
let a: int[5] = 1,8,4,2,10

func insertion_sort() {
    let key : int
    let j: int
    let temp: int
    for (let i: int = 1, i < n, set i += 1) {

        set key = a[i]
        set j = i - 1
        
        asLongAs ( j >= 0 and a[j] > key ) {
            set temp = j + 1
            set a[temp] = a[j]
            set j = j - 1

        }

        set j = j + 1
        set a[j] = key

    }
}

insertion_sort()

let elem: int

for (let k: int = 0, k < n, set k += 1) {
    set elem = a[k]
    show elem
}

