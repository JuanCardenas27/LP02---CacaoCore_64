#define N 7

let n: int = N
let arr: int[N] = 64,34,25,12,22,11,90

func insertion_sort() {
    let key: int
    let j: int
    let temp: int
    for (let i: int = 1, i < n, set i += 1) {
        set key = arr[i]
        set j = i - 1
        asLongAs j >= 0 and arr[j] > key {
            set temp = j + 1
            set arr[temp] = arr[j]
            set j = j - 1
        }
        set j = j + 1
        set arr[j] = key
    }
}

insertion_sort()

let elem: int
for (let k: int = 0, k < n, set k += 1) {
    set elem = arr[k]
    show elem
}
